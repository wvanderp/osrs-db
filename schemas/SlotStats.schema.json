    "type"                : "object",
    "properties"          : {
      "id"            : {
        "type"       : "integer",
        "minimum"    : -9007199254740991,
        "maximum"    : 9007199254740991,
        "description": "The item's ID"
      },
      "name"          : {"type": "string", "description": "The item's name"},
      "members"       : {"type": "boolean", "description": "Whether the item is members-only"},
      "stabAttack"    : {
        "type"       : "integer",
        "minimum"    : -9007199254740991,
        "maximum"    : 9007199254740991,
        "description": "Stab attack bonus"
      },
      "slashAttack"   : {
        "type"       : "integer",
        "minimum"    : -9007199254740991,
        "maximum"    : 9007199254740991,
        "description": "Slash attack bonus"
      },
      "crushAttack"   : {
        "type"       : "integer",
        "minimum"    : -9007199254740991,
        "maximum"    : 9007199254740991,
        "description": "Crush attack bonus"
      },
      "magicAttack"   : {
        "type"       : "integer",
        "minimum"    : -9007199254740991,
        "maximum"    : 9007199254740991,
        "description": "Magic attack bonus"
      },
      "rangedAttack"  : {
        "type"       : "integer",
        "minimum"    : -9007199254740991,
        "maximum"    : 9007199254740991,
        "description": "Ranged attack bonus"
      },
      "stabDefence"   : {
        "type"       : "integer",
        "minimum"    : -9007199254740991,
        "maximum"    : 9007199254740991,
        "description": "Stab defence bonus"
      },
      "slashDefence"  : {
        "type"       : "integer",
        "minimum"    : -9007199254740991,
        "maximum"    : 9007199254740991,
        "description": "Slash defence bonus"
      },
      "crushDefence"  : {
        "type"       : "integer",
        "minimum"    : -9007199254740991,
        "maximum"    : 9007199254740991,
        "description": "Crush defence bonus"
      },
      "magicDefence"  : {
        "type"       : "integer",
        "minimum"    : -9007199254740991,
        "maximum"    : 9007199254740991,
        "description": "Magic defence bonus"
      },
      "rangedDefence" : {
        "type"       : "integer",
        "minimum"    : -9007199254740991,
        "maximum"    : 9007199254740991,
        "description": "Ranged defence bonus"
      },
      "strengthBonus" : {
        "type"       : "integer",
        "minimum"    : -9007199254740991,
