{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type"   : "array",
  "items"  : {
    "type"                : "object",
    "properties"          : {
      "id": {
        "type"       : "integer",
        "minimum"    : -9007199254740991,
        "maximum"    : 9007199254740991,
        "description": "The item's ID"
      },
      "name": {"type": "string", "description": "The item's name"},
      "examine": {"description": "The text that appears when you examine the item", "type": "string"},
      "resizeX": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
      "resizeY": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
      "resizeZ": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
      "xan2d": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
      "yan2d": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
      "zan2d": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
      "cost": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
      "isTradeable": {"description": "Whether or not the item is tradeable", "type": "boolean"},
      "tradeable": {"description": "Whether or not the item is tradeable between players", "type": "boolean"},
      "geTradeable": {"description": "Whether or not the item is tradeable on the Grand Exchange", "type": "boolean"},
      "bronzeman": {
        "description": "The item's Bronzeman cache flag (opcode 251); defaults to false in RuneLite",
        "type"       : "boolean"
      },
      "stackable": {
        "description": "Cache stackability mode: 0, 1 (opcode 11), or 2 (opcode 160)",
        "anyOf"      : [
          {"type": "number", "const": 0}, {"type": "number", "const": 1}, {"type": "number", "const": 2}
        ]
      },
      "holdingWhitelist": {
        "description": "Holding whitelist exported by RuneLite (opcode 161)",
        "type"       : "array",
        "items"      : {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991}
      },
      "inventoryModel": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
      "wearPos1": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
      "wearPos2": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
      "wearPos3": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
      "members": {"description": "Whether or not the item is members only", "type": "boolean"},
      "fullRecolor": {
        "description": "Full-model recolor HSL value (opcode 99), exported as a signed 16-bit integer; -1 means no override",
        "type": "integer",
        "minimum": -32768,
        "maximum": 32767
      },
      "textureFind": {
        "type" : "array",
        "items": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991}
      },
      "textureReplace": {
        "type" : "array",
        "items": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991}
      },
      "colorFind": {
        "type" : "array",
        "items": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991}
      },
      "colorReplace": {
        "type" : "array",
        "items": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991}
      },
      "zoom2d": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
      "xOffset2d": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
      "yOffset2d": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
      "ambient": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
      "contrast": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
      "countCo": {
        "type" : "array",
        "items": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991}
      },
      "countObj": {
        "type" : "array",
        "items": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991}
      },
      "options": {
        "type" : "array",
        "items": {
          "type": ["string", "null"]
        }
      },
      "interfaceOptions": {
        "description": "Options for the item in the interface, such as 'Wear', 'Rub' or 'Drop', etc.",
        "type"       : "array",
        "items"      : {
          "type": ["string", "null"]
        }
      },
      "subops": {
        "description": "Sub-options for each of the interface options",
        "type"       : "array",
        "items"      : {
          "anyOf": [ {"type": "array", "items": {}}, {"type": "null"} ]
        }
      },
      "maleModel0": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
      "maleModel1": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
      "maleModel2": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
      "maleOffset": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
      "maleHeadModel": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
      "maleHeadModel2": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
      "femaleModel0": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
      "femaleModel1": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
      "femaleModel2": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
      "femaleOffset": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
      "femaleHeadModel": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
      "femaleHeadModel2": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
      "category": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
      "notedID": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
      "notedTemplate": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
      "team": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
      "weight": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
      "shiftClickDropIndex": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
      "boughtId": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
      "boughtTemplateId": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
      "placeholderId": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
      "placeholderTemplateId": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
      "params": {
        "type"                : "object",
        "propertyNames"       : {"type": "string"},
        "additionalProperties": {
          "anyOf": [
            {"type": "string"                                                            },
            {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991}
          ]
        }
      },
      "groundOps": {
        "description"         : "Ground interaction options and their conditional variants.",
        "type"                : "object",
        "properties"          : {
          "ops"              : {
            "type" : "array",
            "items": {
              "anyOf": [
                {
                  "type"                : "object",
                  "properties"          : {
                    "text": {"type": "string"}
                  },
                  "required"            : ["text"],
                  "additionalProperties": false
                },
                {"type": "null"}
              ]
            }
          },
          "subOps"           : {
            "type" : "array",
            "items": {
              "anyOf": [ {"type": "array", "items": {}}, {"type": "null"} ]
            }
          },
          "conditionalOps"   : {
            "type" : "array",
            "items": {
              "anyOf": [
                {
                  "type"                : "object",
                  "properties"          : {
                    "text": {"type": "string"}
                  },
                  "required"            : ["text"],
                  "additionalProperties": false
                },
                {"type": "null"}
              ]
            }
          },
          "conditionalSubOps": {
            "type" : "array",
            "items": {
              "anyOf": [ {"type": "array", "items": {}}, {"type": "null"} ]
            }
          }
        },
        "required"            : ["ops", "subOps", "conditionalOps", "conditionalSubOps"],
        "additionalProperties": false
      }
    },
    "required"            : ["id", "name"],
    "additionalProperties": false
  }
}
