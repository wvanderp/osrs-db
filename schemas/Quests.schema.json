{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type"   : "array",
  "items"  : {
    "type"                : "object",
    "properties"          : {
      "id"  : {
        "type"       : "integer",
        "minimum"    : -9007199254740991,
        "maximum"    : 9007199254740991,
        "description": "RuneLite quest ID used by script engine"
      },
      "enum": {"type": "string", "description": "Enum constant name in RuneLite's Quest.java"},
      "name": {"type": "string", "description": "Display name of the quest"}
    },
    "required"            : ["id", "enum", "name"],
    "additionalProperties": false
  }
}
